{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/enforce-briefing.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "AWG_ADDR=localhost:10125 AWG_DOMAIN=github.com/globulario/sensei-prior .claude/hooks/edit-check-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "AWG_ADDR=localhost:10125 AWG_DOMAIN=github.com/globulario/sensei-prior .claude/hooks/push-briefing.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "awareness_briefing|mcp__.*__awareness_briefing",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/record-briefing.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/feedback-reminder.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
